@page "/fornecedor/guardar/{Id:guid?}"
@using FaturaFlow.Application.Services
@using FaturaFlow.Presentation.Services
@inject SupplierService SupplierService
@inject NavigationManager Navigation
@inject UserSession UserSession 

<PageTitle>@(Id.HasValue ? "Editar" : "Novo") Fornecedor - FaturaFlow</PageTitle>

<style>
    :root {
        --ff-dark-blue: #002d5b;
        --ff-blue: #0056b3;
        --ff-cyan: #00bcd4;
    }

    .ff-form-card { border-radius: 16px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1); overflow: hidden; max-width: 900px; margin: auto; }
    .ff-form-header { background: var(--ff-dark-blue); color: white; padding: 1.5rem 2rem; border-bottom: 4px solid var(--ff-cyan); }
    .ff-input-group { position: relative; }
    .ff-input-group i { position: absolute; left: 12px; top: 38px; color: var(--ff-blue); opacity: 0.5; }
    .ff-form-control { padding-left: 38px !important; border-radius: 8px; border: 1px solid #dee2e6; transition: all 0.3s; }
    .ff-form-control:focus { border-color: var(--ff-cyan); box-shadow: 0 0 0 0.25rem rgba(0, 188, 212, 0.1); }
    .ff-section-title { font-size: 0.85rem; font-weight: 700; color: var(--ff-blue); text-transform: uppercase; letter-spacing: 1px; margin-top: 1.5rem; margin-bottom: 1rem; display: flex; align-items: center; }
    .ff-section-title::after { content: ""; flex: 1; height: 1px; background: #eee; margin-left: 15px; }
</style>

<div class="container py-5">
    <div class="card ff-form-card">
        <div class="ff-form-header d-flex align-items-center">
            <i class="bi bi-building-add fs-2 me-3"></i>
            <div>
                <h4 class="mb-0 fw-bold">@(Id.HasValue ? "Atualizar Registo" : "Registar Fornecedor")</h4>
                <small class="opacity-75">Preencha os dados fiscais e de contacto da empresa.</small>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            @if (!UserSession.IsLoggedIn) 
            {
                <div class="container mt-5 text-center">
                    <div class="alert alert-warning shadow-sm p-5 rounded-4">
                        <i class="bi bi-shield-lock display-4 d-block mb-3"></i>
                        <h4 class="fw-bold">Acesso Negado</h4>
                        <p>Inicie sessão para gerir a base de dados de clientes.</p>
                        <button class="btn btn-primary px-4" @onclick='() => Navigation.NavigateTo("/login")'>Ir para Login</button>
                    </div>
                </div>
            }
            else if (isLoading) 
            {
                <div class="text-center py-5"><div class="spinner-border text-cyan"></div><p class="mt-2 text-muted">A carregar dados...</p></div>
            }
            else 
            {
                <EditForm Model="@model" OnValidSubmit="HandleSave">
                    <DataAnnotationsValidator />

                    <!-- SECÇÃO 1: IDENTIFICAÇÃO -->
                    <div class="ff-section-title">Identificação Fiscal</div>
                    <div class="row g-3">
                        <div class="col-md-8 ff-input-group">
                            <label class="form-label fw-semibold small">Nome da Empresa</label>
                            <i class="bi bi-building"></i>
                            <InputText @bind-Value="model.CompanyName" class="form-control ff-form-control" placeholder="Razão Social Completa" />
                            <ValidationMessage For="@(() => model.CompanyName)" class="small text-danger" />
                        </div>
                        <div class="col-md-4 ff-input-group">
                            <label class="form-label fw-semibold small">NIPC</label>
                            <i class="bi bi-vcard"></i>
                            <InputText @bind-Value="model.NIPC" class="form-control ff-form-control" placeholder="9 dígitos" />
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12 ff-input-group">
                            <label class="form-label fw-semibold small">Representante Legal</label>
                            <i class="bi bi-person-badge"></i>
                            <InputText @bind-Value="model.RepresentativeName" class="form-control ff-form-control" placeholder="Nome do contacto principal" />
                        </div>
                    </div>

                    <!-- SECÇÃO 2: CONTACTOS -->
                    <div class="ff-section-title">Informações de Contacto</div>
                    <div class="row g-3">
                        <div class="col-md-6 ff-input-group">
                            <label class="form-label fw-semibold small">E-mail</label>
                            <i class="bi bi-envelope-at"></i>
                            <InputText @bind-Value="model.Email" class="form-control ff-form-control" placeholder="exemplo@empresa.com" />
                        </div>
                        <div class="col-md-6 ff-input-group">
                            <label class="form-label fw-semibold small">Telefone / Telemóvel</label>
                            <i class="bi bi-telephone"></i>
                            <InputText @bind-Value="model.Phone" class="form-control ff-form-control" placeholder="+351 --- --- ---" />
                        </div>
                    </div>

                    <!-- SECÇÃO 3: LOCALIZAÇÃO -->
                    <div class="ff-section-title">Sede e Localização</div>
                    <div class="row g-3">
                        <div class="col-12 ff-input-group">
                            <label class="form-label fw-semibold small">Morada Completa</label>
                            <i class="bi bi-geo-alt"></i>
                            <InputText @bind-Value="model.Address" class="form-control ff-form-control" placeholder="Rua, Número, Andar..." />
                        </div>
                        <div class="col-md-8 ff-input-group">
                            <label class="form-label fw-semibold small">Cidade</label>
                            <i class="bi bi-map"></i>
                            <InputText @bind-Value="model.City" class="form-control ff-form-control" />
                        </div>
                        <div class="col-md-4 ff-input-group">
                            <label class="form-label fw-semibold small">Código Postal</label>
                            <i class="bi bi-mailbox"></i>
                            <InputText @bind-Value="model.ZipCode" class="form-control ff-form-control" placeholder="0000-000" />
                        </div>
                    </div>

                    <div class="mt-5 d-flex gap-3">
                        <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm" style="background-color: var(--ff-dark-blue); border: none;">
                            <i class="bi bi-check-circle me-2"></i>GUARDAR FORNECEDOR
                        </button>
                        <button type="button" class="btn btn-outline-secondary px-4 py-2" @onclick='() => Navigation.NavigateTo("/Fornecedores/Ver")'>
                            CANCELAR
                        </button>
                    </div>
                </EditForm>

                @if (!string.IsNullOrEmpty(errorMessage)) 
                { 
                    <div class="alert alert-danger mt-4 border-0 shadow-sm d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                    </div> 
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    private SupplierFormModel model = new();
    private bool isLoading = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync() {
        if (!UserSession.IsLoggedIn) return;
        if (Id.HasValue && Id != Guid.Empty) {
            var s = await SupplierService.GetByIdAsync(Id.Value);
            if (s != null) {
                model = new SupplierFormModel {
                    CompanyName = s.CompanyName,
                    NIPC = s.NIPC?.Value ?? "",
                    RepresentativeName = s.RepresentativeName ?? "",
                    Phone = s.Phone?.Value ?? "",
                    Email = s.Email?.Value ?? "",
                    Address = s.Address ?? "",
                    City = s.City ?? "",
                    ZipCode = s.ZipCode?.Value ?? ""
                };
            }
        }
        isLoading = false;
    }

    private async Task HandleSave() {
        try {
            errorMessage = "";
            await SupplierService.SaveSupplierAsync(Id, model.CompanyName, model.NIPC, model.RepresentativeName, model.Phone, model.Email, model.Address, model.City, model.ZipCode);
            Navigation.NavigateTo("/Fornecedores/Ver");
        } 
        catch (Exception ex) 
        { 
            errorMessage = ex.Message;
            
        }
    }

    public class SupplierFormModel {
        public string CompanyName { get; set; } = "";
        public string NIPC { get; set; } = "";
        public string RepresentativeName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
        public string Address { get; set; } = "";
        public string City { get; set; } = "";
        public string ZipCode { get; set; } = "";
    }
}