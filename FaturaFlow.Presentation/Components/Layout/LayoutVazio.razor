@inherits LayoutComponentBase

<!-- This layout is used for pages that should not have the standard navigation menu, such as the login page. It provides a clean and simple layout for these pages. -->
<div class="layout-vazio-container">
    @Body
</div>

<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    .layout-vazio-container {
        min-height: 100vh;
        width: 100%;
    }
</style>