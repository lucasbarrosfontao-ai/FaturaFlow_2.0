@using FaturaFlow.Presentation.Services
@inject UserSession session
@inject NavigationManager Navigation


<div class="top-row ff-navbar navbar navbar-dark shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand ff-brand fw-bold d-flex align-items-center" href="">
            <i class="bi bi-lightning-charge-fill me-2" style="color: var(--nav-cyan);"></i>
            <span>FaturaFlow</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable ff-nav-container" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column mt-2">
        
        <!-- SECÇÃO: PRINCIPAL -->
        <div class="nav-item px-2">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
            </NavLink>
        </div>

        <div class="ff-nav-section-title">Gestão Operacional</div>

        <div class="nav-item px-2">
            <NavLink class="nav-link" href="Fornecedores/Ver">
                <i class="bi bi-truck me-2"></i> Fornecedores
            </NavLink>
        </div>

        <div class="nav-item px-2">
            <NavLink class="nav-link" href="Clientes/Ver">
                <i class="bi bi-people-fill me-2"></i> Clientes
            </NavLink>
        </div>

        <div class="nav-item px-2">
            <NavLink class="nav-link" href="Produtos/Ver">
                <i class="bi bi-box-seam me-2"></i> Inventário
            </NavLink>
        </div>

        <div class="ff-nav-section-title">Documentação</div>

        <div class="nav-item px-2">
            <NavLink class="nav-link" href="Faturas/Ver">
                <i class="bi bi-files me-2"></i> Histórico Faturas
            </NavLink>
        </div>
        
        <div class="nav-item px-2">
            <NavLink class="nav-link" href="Faturas/Criar">
                <i class="bi bi-plus-circle-fill me-2" style="color: var(--nav-cyan);"></i> Nova Fatura
            </NavLink>
        </div>

        <div class="ff-nav-section-title">Relatórios & BI</div>

        <div class="nav-item px-2">
            <NavLink class="nav-link" href="Vendas/VisaoGeral">
                <i class="bi bi-bar-chart-line-fill me-2"></i> Análise Vendas
            </NavLink>
        </div>
        
        <!-- SECÇÃO: SISTEMA & SEGURANÇA -->
        <div class="ff-nav-section-title">Configurações</div>

        @if (session.IsLoggedIn)
        {
            <div class="nav-item px-2">
                <NavLink class="nav-link" href="Empresa">
                    <i class="bi bi-building-gear me-2"></i> Minha Empresa
                </NavLink>
            </div>

            <div class="nav-item px-2">
                <NavLink class="nav-link" href="Utilizadores/Ver">
                    <i class="bi bi-shield-lock-fill me-2"></i> Utilizadores
                </NavLink>
            </div>
        }

        <div class="nav-item px-2">
            <NavLink class="nav-link" href="arquivo">
                <i class="bi bi-archive-fill me-2" style="opacity: 0.7;"></i> Arquivo Morto
            </NavLink>
        </div>

        <!-- BOTÃO SAIR -->
        @if (session.IsLoggedIn)
        {
            <div class="nav-item px-2 mt-4">
                <button class="nav-link btn btn-link w-100 text-start border-0 ff-logout-btn" @onclick="Logout">
                    <i class="bi bi-power me-2"></i> Terminar Sessão
                </button>
            </div>
        }

    </nav>
</div>

@code {
    private void Logout()
    {
        session.IsLoggedIn = false;
        Navigation.NavigateTo("/login");
    }
}